@using FrontEnd.Services
@using System.Net
@inject TokenService _TokenService;
@inject Events _Events;
@inject NavigationManager _NavigationManager;

<nav class="fixed-top navbar navbar-expand-lg navbar-light" id="navbarNav">
    <div class="container">
        <a class="navbar-brand text-white" href="#">Online Advertising</a>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ml-auto">
                <li class="nav-item">
                    <a class="nav-link text-white" href="/">Home</a>
                </li>

                @if (IsUserLoggedIn)
                {
                    <li class="nav-item">
                        <a class="nav-link text-white" href="/Profile">Profile</a>
                    </li>
                }

                @if (!IsUserLoggedIn)
                {
                    <li class="nav-item">
                        <a class="nav-link text-white" href="/Auth/SignIn">Login</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="/Auth/SignUp">Register</a>
                    </li>
                }

                @if (IsUserLoggedIn)
                {
                    <li class="nav-item">
                        <button class="btn btn-link nav-link text-white" @onclick="Logout">Logout</button>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>


@code {

    private bool IsUserLoggedIn;

    protected override async Task OnInitializedAsync()
    {
        IsUserLoggedIn = await _TokenService.HasValidTokenAsync();
        _Events.OnSignIn += HandleOnSignIn;
    }

    private void HandleOnSignIn()
    {
        IsUserLoggedIn = true;
        StateHasChanged();
    }

    private async Task Logout()
    {
        await _TokenService.ClearAsync();
        IsUserLoggedIn = false;

        StateHasChanged();

        _NavigationManager.NavigateTo("/Auth/SignIn");
    }

}