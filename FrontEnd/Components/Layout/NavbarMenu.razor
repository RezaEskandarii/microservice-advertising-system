@code {
    private bool IsUserLoggedIn => !string.IsNullOrEmpty(GetTokenFromLocalStorage());

    private string GetTokenFromLocalStorage()
    {
        return "";
    }

    private void Logout()
    {
    // Clear JWT token from LocalStorage or perform logout logic
    }

}

<nav class="fixed-top navbar navbar-expand-lg navbar-light" id="navbarNav">
    <div class="container">
        <a class="navbar-brand text-white" href="#">YourApp</a>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ml-auto">
                <li class="nav-item">
                    <a class="nav-link text-white" href="/">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" href="/profile">Profile</a>
                </li>
                @if (!IsUserLoggedIn)
                {
                    <li class="nav-item">
                        <a class="nav-link text-white" href="/login">Login</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="/SignUp">Register</a>
                    </li>
                }
                <li class="nav-item">
                    <a class="nav-link text-white" href="/search">Search</a>
                </li>
                @if (IsUserLoggedIn)
                {
                    <li class="nav-item">
                        <button class="btn btn-link nav-link text-white" @onclick="Logout">Logout</button>
                    </li>
                }
            </ul>
        </div>
    </div>
