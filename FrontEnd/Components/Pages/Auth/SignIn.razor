@page "/signin"
@using FrontEnd.Models
@using FrontEnd.Constants
@using FrontEnd.Extensions
@using FrontEnd.Services
@inject IHttpClientFactory _HttpClientFactory;
@inject NavigationManager _NavigationManager;
@inject TokenService _TokenService;
@inject Events _Events;
<div class="container">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    Sign In
                </div>
                <EditForm Model="@_signInData" OnValidSubmit="@SignInUser" class="needs-validation">
                    <div class="card-body">

                        <div class="form-group">
                            <label for="username">Username</label>
                            <InputText id="username" @bind-Value="@_signInData.Username" class="form-control"/>
                            <ValidationMessage For="@(() => _signInData.Username)"/>
                        </div>
                        <div class="form-group">
                            <label for="password">Password</label>
                            <InputText id="password" @bind-Value="@_signInData.Password" type="password" class="form-control"/>
                            <ValidationMessage For="@(() => _signInData.Password)"/>
                        </div>

                        <ValidationSummary/>
                        <ErrorsAlert ErrorsList="_errors"/>

                    </div>
                    <div class="card-footer text-center">
                        <button type="submit" class="btn btn-primary">Sign In</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {

     

    readonly SignInModel _signInData = new SignInModel();
    List<string>? _errors;

    private async Task SignInUser()
    {
        
        var client = _HttpClientFactory.CreateClient(ApiConfigs.AdvertisementClient);
        var resp = await client.PostAsJsonAsync(ApiConfigs.SignInApiAddress, _signInData);

        var respObj = await resp.DeserializeContentAsync<ApiResponse<SignInResponse>>();

        if (resp.IsSuccessStatusCode && respObj is not {responseObject.authToken: "" })
        {
            await _TokenService.SetAsync(respObj.responseObject);
            _Events.InvokeSignIn();
            
            _NavigationManager.NavigateTo("/");
        }
        else
        {
            _errors = respObj.errorMessages;
        }
    }

}