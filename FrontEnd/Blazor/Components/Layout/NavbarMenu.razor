@using FrontEnd.Services
@using System.Net
@inject TokenService _TokenService;
@inject Events _Events;
@inject NavigationManager _NavigationManager;

<nav class="fixed-top navbar navbar-expand-lg navbar-light" id="navbarNav">
    <div class="container">
        <a class="navbar-brand text-white" href="#">Online Advertising</a>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ml-auto">
                <li class="nav-item">
                    <a class="nav-link text-white" href="/">Home</a>
                </li>
        <li class="nav-item dropdown">
          <a class="nav-link text-white dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            Dropdown
          </a>
          <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="#">Action</a></li>
            <li><a class="dropdown-item" href="#">Another action</a></li>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item" href="#">Something else here</a></li>
          </ul>
        </li>
                @if (IsUserLoggedIn)
                {
                    <li class="nav-item">
                        <a class="nav-link text-white" href="/Profile">Profile</a>
                    </li>
                }

                @if (!IsUserLoggedIn)
                {
                    <li class="nav-item">
                        <a class="nav-link text-white" href="/Auth/SignIn">Login</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="/Auth/SignUp">Register</a>
                    </li>
                }

                @if (IsUserLoggedIn)
                {
                    <li class="nav-item">
                        <button class="btn btn-link nav-link text-white" @onclick="Logout">Logout</button>
                    </li>
                }

                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button"
                       data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        User Profile
                    </a>
                    <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                        <a class="dropdown-item" href="#">Profile</a>
                        <div class="dropdown-divider"></div>
                        <a class="dropdown-item" href="#">Settings</a>
                        <a class="dropdown-item" href="#">Another action</a>
                        <div class="dropdown-divider"></div>
                        <a class="dropdown-item" href="#">Logout</a>
                    </div>
                </li>
            </ul>
        </div>
    </div>
</nav>
 
@code {

    private bool IsUserLoggedIn;

    protected override async Task OnInitializedAsync()
    {
        IsUserLoggedIn = await _TokenService.HasValidTokenAsync();
        _Events.OnSignIn += HandleOnSignIn;
    }

    private void HandleOnSignIn()
    {
        IsUserLoggedIn = true;
        StateHasChanged();
    }

    private async Task Logout()
    {
        await _TokenService.ClearAsync();
        IsUserLoggedIn = false;

        StateHasChanged();

        _NavigationManager.NavigateTo("/Auth/SignIn");
    }

}