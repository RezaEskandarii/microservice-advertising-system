VAULT_ADDRESS=http://vault:8200

# Identity Management API Configuration
IDENTITY_CONNECTION_STRING="Server=postgres;Port=5432;Database=AdvertisementsIdentityDB;User Id=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}"
IDENTITY_KESTREL_URL=http://0.0.0.0:5004

# Advertisement Management API Configuration
ADVERTISEMENT_CONNECTION_STRING="Server=postgres;Port=5432;Database=AdvertisementsDB;User Id=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}"
ADVERTISEMENT_RABBITMQ_URL=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@rabbitmq:${RABBITMQ_PORT}
ADVERTISEMENT_ELASTICSEARCH_URL=http://elasticsearch:${ELASTICSEARCH_PORT}
ADVERTISEMENT_KESTREL_URL=http://0.0.0.0:5006

# Email Sender API Configuration
EMAIL_SENDER_PORT=5007
EMAIL_SENDER_RABBITMQ_URL=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@rabbitmq:${RABBITMQ_PORT}

# Thumbnail Management API Configuration
THUMBNAIL_MINIO_ADDRESS=minio:${MINIO_PORT}
THUMBNAIL_MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
THUMBNAIL_MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}
THUMBNAIL_VAULT_TOKEN=${VAULT_DEV_ROOT_TOKEN_ID}
THUMBNAIL_VAULT_ADDRESS=${VAULT_ADDRESS}
THUMBNAIL_GRPC_PORT=5002
THUMBNAIL_POSTGRES_BASE="user=${POSTGRES_USER} password=${POSTGRES_PASSWORD} host=postgres port=5432 sslmode=disable"
THUMBNAIL_POSTGRES_FULL="user=${POSTGRES_USER} password=${POSTGRES_PASSWORD} host=postgres port=5432 dbname=advertisement_thumbnails sslmode=disable"

# Category Management API Configuration
CATEGORY_POSTGRES_BASE="user=${POSTGRES_USER} password=${POSTGRES_PASSWORD} host=postgres port=5432 sslmode=disable"
CATEGORY_POSTGRES_FULL="user=${POSTGRES_USER} password=${POSTGRES_PASSWORD} host=postgres port=5432 dbname=category_management sslmode=disable"

# Location Management API Configuration
LOCATION_POSTGRES_BASE="user=${POSTGRES_USER} password=${POSTGRES_PASSWORD} host=postgres port=5432 sslmode=disable"
LOCATION_POSTGRES_FULL="user=${POSTGRES_USER} password=${POSTGRES_PASSWORD} host=postgres port=5432 dbname=location_management sslmode=disable"
LOCATION_APP_PORT=5010

# Wallet API Configuration
WALLET_POSTGRES_CONNECTION="user=${POSTGRES_USER} password=boofhichkas host=127.0.0.1 port=5432 sslmode=disable"
