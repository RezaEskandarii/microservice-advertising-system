{
  "GlobalConfiguration": {
    "RequestIdKey": "X-Request-ID",
    "GlobalConfiguration": {
      "BaseUrl": "http://127.0.0.1:5009"
    }
  },
  "Routes": [
    {
      "UpstreamPathTemplate": "/api/v1/Identity/SignUp",
      "UpstreamHttpMethod": [
        "POST"
      ],
      "DownstreamPathTemplate": "/api/User/SignUp",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "identity-management.api",
          "Port": 5004
        }
      ]
    },
    {
      "UpstreamPathTemplate": "/api/v1/Identity/SignIn",
      "UpstreamHttpMethod": [
        "POST"
      ],
      "DownstreamPathTemplate": "/api/User/SignIn",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "identity-management.api",
          "Port": 5004
        }
      ]
    },
    {
      "UpstreamPathTemplate": "/api/v1/categories",
      "UpstreamHttpMethod": [
        "GET"
      ],
      "DownstreamPathTemplate": "/api/v1/categories",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "category-management.api",
          "Port": 5005
        }
      ]
    },
    {
      "UpstreamPathTemplate": "/api/v1/Advertisement",
      "UpstreamHttpMethod": [
        "POST"
      ],
      "DownstreamPathTemplate": "/api/v1/Advertisement",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "advertisement-management.api",
          "Port": 5006
        }
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      },
      "AddHeadersToRequest": {
        "Authorization": "Bearer {token}"
      }
    },
    {
      "UpstreamPathTemplate": "/api/v1/Advertisement/{id}",
      "UpstreamHttpMethod": [
        "GET"
      ],
      "DownstreamPathTemplate": "/api/v1/Advertisement/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "advertisement-management.api",
          "Port": 5006
        }
      ]
    },
    {
      "UpstreamPathTemplate": "/api/v1/Advertisement/Remove/{id}",
      "UpstreamHttpMethod": [
        "DELETE"
      ],
      "DownstreamPathTemplate": "/api/v1/Advertisement/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "advertisement-management.api",
          "Port": 5006
        }
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      },
      "AddHeadersToRequest": {
        "Authorization": "Bearer {token}"
      }
    },
    {
      "UpstreamPathTemplate": "/api/v1/Advertisement/Update/{id}",
      "UpstreamHttpMethod": [
        "PUT"
      ],
      "DownstreamPathTemplate": "/api/v1/Advertisement/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "advertisement-management.api",
          "Port": 5006
        }
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer"
      },
      "AddHeadersToRequest": {
        "Authorization": "Bearer {token}"
      }
    },
    {
      "UpstreamPathTemplate": "/api/v1/locations",
      "UpstreamHttpMethod": [
        "GET"
      ],
      "DownstreamPathTemplate": "/api/v1/locations",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "location-management.api",
          "Port": 5010
        }
      ]
    }
  ]
}

